{
    "openapi": "3.0.0",
    "info": {
        "title": "IziCRM API",
        "description": "API documentation for IziCRM",
        "version": "1.0.0"
    },
    "paths": {
        "/api/queries": {
            "get": {
                "tags": [
                    "Queries"
                ],
                "summary": "Get all finished queries",
                "operationId": "f541c46bb1d6da9430b73fb2d3b41d8c",
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "custom_id": {
                                                        "type": "string",
                                                        "example": "abc123"
                                                    },
                                                    "count": {
                                                        "type": "integer",
                                                        "example": 10
                                                    },
                                                    "telegram_group_count": {
                                                        "type": "integer",
                                                        "example": 5
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No data found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "No data found"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/query/check": {
            "post": {
                "tags": [
                    "Queries"
                ],
                "summary": "Check Telegram by custom_id",
                "description": "Search Telegram messages globally using custom_id and return count",
                "operationId": "checkTelegram",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "custom_id"
                                ],
                                "properties": {
                                    "custom_id": {
                                        "type": "string",
                                        "example": "ABC123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "custom_id": {
                                            "type": "string",
                                            "example": "ABC123"
                                        },
                                        "count": {
                                            "type": "integer",
                                            "example": 25
                                        },
                                        "crm_status": {
                                            "type": "integer",
                                            "example": 200
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error"
                    },
                    "500": {
                        "description": "Server error"
                    }
                }
            }
        },
