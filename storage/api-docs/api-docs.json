        "/api/query/result/{custom_id}": {
            "get": {
                "tags": [
                    "Queries"
                ],
                "summary": "Get Telegram check result",
                "description": "Returns Telegram search result by custom_id. If the process is not finished yet, status will be 'processing'.",
                "operationId": "getTelegramQueryResult",
                "parameters": [
                    {
                        "name": "custom_id",
                        "in": "path",
                        "description": "Unique identifier used for Telegram search",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "ABC123"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Result retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "custom_id": {
                                            "type": "string",
                                            "example": "ABC123"
                                        },
                                        "count": {
                                            "type": "integer",
                                            "example": 25
                                        },
                                        "status": {
                                            "type": "string",
                                            "example": "done",
                                            "enum": [
                                                "processing",
                                                "done"
                                            ]
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Query not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
